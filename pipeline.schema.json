{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vulkan Pipeline Create Info Schema",
  "description": "A comprehensive JSON Schema for creating a vk::Pipeline (graphics or compute) based on the Vulkan specification.",
  "oneOf": [
    {
      "title": "Graphics Pipeline",
      "type": "object",
      "properties": {
        "type": {
          "enum": ["graphics"]
        },
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO"]
        },
        "pNext": {
          "description": "Extension chain",
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "description": "Pipeline creation flags",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "VK_PIPELINE_CREATE_DISABLE_OPTIMIZATION_BIT",
              "VK_PIPELINE_CREATE_ALLOW_DERIVATIVES_BIT",
              "VK_PIPELINE_CREATE_DERIVATIVE_BIT"
            ]
          }
        },
        "stages": {
          "description": "Array of shader stage create info structures",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PipelineShaderStageCreateInfo"
          }
        },
        "vertexInputState": {
          "$ref": "#/definitions/PipelineVertexInputStateCreateInfo"
        },
        "inputAssemblyState": {
          "$ref": "#/definitions/PipelineInputAssemblyStateCreateInfo"
        },
        "tessellationState": {
          "$ref": "#/definitions/PipelineTessellationStateCreateInfo"
        },
        "viewportState": {
          "$ref": "#/definitions/PipelineViewportStateCreateInfo"
        },
        "rasterizationState": {
          "$ref": "#/definitions/PipelineRasterizationStateCreateInfo"
        },
        "multisampleState": {
          "$ref": "#/definitions/PipelineMultisampleStateCreateInfo"
        },
        "depthStencilState": {
          "$ref": "#/definitions/PipelineDepthStencilStateCreateInfo"
        },
        "colorBlendState": {
          "$ref": "#/definitions/PipelineColorBlendStateCreateInfo"
        },
        "dynamicState": {
          "$ref": "#/definitions/PipelineDynamicStateCreateInfo"
        },
        "layout": {
          "description": "Pipeline layout handle or identifier",
          "type": "string"
        },
        "renderPass": {
          "description": "Render pass handle or identifier",
          "type": "string"
        },
        "subpass": {
          "type": "integer"
        },
        "basePipelineHandle": {
          "description": "Handle of an existing pipeline",
          "type": "string"
        },
        "basePipelineIndex": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "sType",
        "stages",
        "layout",
        "renderPass",
        "subpass"
      ],
      "additionalProperties": false
    },
    {
      "title": "Compute Pipeline",
      "type": "object",
      "properties": {
        "type": {
          "enum": ["compute"]
        },
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO"]
        },
        "pNext": {
          "description": "Extension chain",
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "description": "Pipeline creation flags",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "VK_PIPELINE_CREATE_ALLOW_DERIVATIVES_BIT",
              "VK_PIPELINE_CREATE_DERIVATIVE_BIT"
            ]
          }
        },
        "stage": {
          "$ref": "#/definitions/PipelineShaderStageCreateInfo"
        },
        "layout": {
          "description": "Pipeline layout handle or identifier",
          "type": "string"
        },
        "basePipelineHandle": {
          "description": "Handle of an existing pipeline",
          "type": "string"
        },
        "basePipelineIndex": {
          "type": "integer"
        }
      },
      "required": ["type", "sType", "stage", "layout"],
      "additionalProperties": false
    }
  ],
  "definitions": {
    "PipelineShaderStageCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO"]
        },
        "pNext": {
          "description": "Extension chain",
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "description": "Shader stage creation flags",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": "string",
          "enum": [
            "VK_SHADER_STAGE_VERTEX_BIT",
            "VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT",
            "VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT",
            "VK_SHADER_STAGE_GEOMETRY_BIT",
            "VK_SHADER_STAGE_FRAGMENT_BIT",
            "VK_SHADER_STAGE_COMPUTE_BIT",
            "VK_SHADER_STAGE_ALL_GRAPHICS",
            "VK_SHADER_STAGE_ALL"
          ]
        },
        "module": {
          "description": "Shader module handle or identifier",
          "type": "string"
        },
        "pName": {
          "description": "Entry point name",
          "type": "string"
        },
        "pSpecializationInfo": {
          "description": "Specialization information (if any)",
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        }
      },
      "required": ["sType", "stage", "module", "pName"],
      "additionalProperties": false
    },
    "PipelineVertexInputStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vertexBindingDescriptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VertexInputBindingDescription"
          }
        },
        "vertexAttributeDescriptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VertexInputAttributeDescription"
          }
        }
      },
      "required": ["sType"],
      "additionalProperties": false
    },
    "VertexInputBindingDescription": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "integer"
        },
        "stride": {
          "type": "integer"
        },
        "inputRate": {
          "type": "string",
          "enum": [
            "VK_VERTEX_INPUT_RATE_VERTEX",
            "VK_VERTEX_INPUT_RATE_INSTANCE"
          ]
        }
      },
      "required": ["binding", "stride", "inputRate"],
      "additionalProperties": false
    },
    "VertexInputAttributeDescription": {
      "type": "object",
      "properties": {
        "location": {
          "type": "integer"
        },
        "binding": {
          "type": "integer"
        },
        "format": {
          "type": "string",
          "enum": [
            "VK_FORMAT_UNDEFINED",
            "VK_FORMAT_R4G4_UNORM_PACK8",
            "VK_FORMAT_R4G4B4A4_UNORM_PACK16",
            "VK_FORMAT_B4G4R4A4_UNORM_PACK16"
          ]
        },
        "offset": {
          "type": "integer"
        }
      },
      "required": ["location", "binding", "format", "offset"],
      "additionalProperties": false
    },
    "PipelineInputAssemblyStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": [
            "VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO"
          ]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "topology": {
          "type": "string",
          "enum": [
            "VK_PRIMITIVE_TOPOLOGY_POINT_LIST",
            "VK_PRIMITIVE_TOPOLOGY_LINE_LIST",
            "VK_PRIMITIVE_TOPOLOGY_LINE_STRIP",
            "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST",
            "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP",
            "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN",
            "VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY",
            "VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY",
            "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY",
            "VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY",
            "VK_PRIMITIVE_TOPOLOGY_PATCH_LIST"
          ]
        },
        "primitiveRestartEnable": {
          "type": "boolean"
        }
      },
      "required": ["sType", "topology"],
      "additionalProperties": false
    },
    "PipelineTessellationStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "patchControlPoints": {
          "type": "integer"
        }
      },
      "required": ["sType", "patchControlPoints"],
      "additionalProperties": false
    },
    "PipelineViewportStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "viewportCount": {
          "type": "integer"
        },
        "scissorCount": {
          "type": "integer"
        },
        "pViewports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Viewport"
          }
        },
        "pScissors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rect2D"
          }
        }
      },
      "required": ["sType"],
      "additionalProperties": false
    },
    "Viewport": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "minDepth": { "type": "number" },
        "maxDepth": { "type": "number" }
      },
      "required": ["x", "y", "width", "height", "minDepth", "maxDepth"],
      "additionalProperties": false
    },
    "Rect2D": {
      "type": "object",
      "properties": {
        "offset": {
          "$ref": "#/definitions/Offset2D"
        },
        "extent": {
          "$ref": "#/definitions/Extent2D"
        }
      },
      "required": ["offset", "extent"],
      "additionalProperties": false
    },
    "Offset2D": {
      "type": "object",
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "Extent2D": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "PipelineRasterizationStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depthClampEnable": {
          "type": "boolean"
        },
        "rasterizerDiscardEnable": {
          "type": "boolean"
        },
        "polygonMode": {
          "type": "string",
          "enum": [
            "VK_POLYGON_MODE_FILL",
            "VK_POLYGON_MODE_LINE",
            "VK_POLYGON_MODE_POINT"
          ]
        },
        "cullMode": {
          "type": "string",
          "enum": [
            "VK_CULL_MODE_NONE",
            "VK_CULL_MODE_FRONT_BIT",
            "VK_CULL_MODE_BACK_BIT",
            "VK_CULL_MODE_FRONT_AND_BACK"
          ]
        },
        "frontFace": {
          "type": "string",
          "enum": ["VK_FRONT_FACE_COUNTER_CLOCKWISE", "VK_FRONT_FACE_CLOCKWISE"]
        },
        "depthBiasEnable": {
          "type": "boolean"
        },
        "depthBiasConstantFactor": {
          "type": "number"
        },
        "depthBiasClamp": {
          "type": "number"
        },
        "depthBiasSlopeFactor": {
          "type": "number"
        },
        "lineWidth": {
          "type": "number"
        }
      },
      "required": ["sType", "polygonMode", "cullMode", "frontFace"],
      "additionalProperties": false
    },
    "PipelineMultisampleStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rasterizationSamples": {
          "type": "string",
          "enum": [
            "VK_SAMPLE_COUNT_1_BIT",
            "VK_SAMPLE_COUNT_2_BIT",
            "VK_SAMPLE_COUNT_4_BIT",
            "VK_SAMPLE_COUNT_8_BIT",
            "VK_SAMPLE_COUNT_16_BIT",
            "VK_SAMPLE_COUNT_32_BIT",
            "VK_SAMPLE_COUNT_64_BIT"
          ]
        },
        "sampleShadingEnable": {
          "type": "boolean"
        },
        "minSampleShading": {
          "type": "number"
        },
        "pSampleMask": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "alphaToCoverageEnable": {
          "type": "boolean"
        },
        "alphaToOneEnable": {
          "type": "boolean"
        }
      },
      "required": ["sType", "rasterizationSamples"],
      "additionalProperties": false
    },
    "PipelineDepthStencilStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depthTestEnable": {
          "type": "boolean"
        },
        "depthWriteEnable": {
          "type": "boolean"
        },
        "depthCompareOp": {
          "type": "string",
          "enum": [
            "VK_COMPARE_OP_NEVER",
            "VK_COMPARE_OP_LESS",
            "VK_COMPARE_OP_EQUAL",
            "VK_COMPARE_OP_LESS_OR_EQUAL",
            "VK_COMPARE_OP_GREATER",
            "VK_COMPARE_OP_NOT_EQUAL",
            "VK_COMPARE_OP_GREATER_OR_EQUAL",
            "VK_COMPARE_OP_ALWAYS"
          ]
        },
        "depthBoundsTestEnable": {
          "type": "boolean"
        },
        "stencilTestEnable": {
          "type": "boolean"
        },
        "front": {
          "$ref": "#/definitions/StencilOpState"
        },
        "back": {
          "$ref": "#/definitions/StencilOpState"
        },
        "minDepthBounds": {
          "type": "number"
        },
        "maxDepthBounds": {
          "type": "number"
        }
      },
      "required": ["sType"],
      "additionalProperties": false
    },
    "StencilOpState": {
      "type": "object",
      "properties": {
        "failOp": {
          "type": "string",
          "enum": [
            "VK_STENCIL_OP_KEEP",
            "VK_STENCIL_OP_ZERO",
            "VK_STENCIL_OP_REPLACE",
            "VK_STENCIL_OP_INCREMENT_AND_CLAMP",
            "VK_STENCIL_OP_DECREMENT_AND_CLAMP",
            "VK_STENCIL_OP_INVERT",
            "VK_STENCIL_OP_INCREMENT_AND_WRAP",
            "VK_STENCIL_OP_DECREMENT_AND_WRAP"
          ]
        },
        "passOp": {
          "type": "string",
          "enum": [
            "VK_STENCIL_OP_KEEP",
            "VK_STENCIL_OP_ZERO",
            "VK_STENCIL_OP_REPLACE",
            "VK_STENCIL_OP_INCREMENT_AND_CLAMP",
            "VK_STENCIL_OP_DECREMENT_AND_CLAMP",
            "VK_STENCIL_OP_INVERT",
            "VK_STENCIL_OP_INCREMENT_AND_WRAP",
            "VK_STENCIL_OP_DECREMENT_AND_WRAP"
          ]
        },
        "depthFailOp": {
          "type": "string",
          "enum": [
            "VK_STENCIL_OP_KEEP",
            "VK_STENCIL_OP_ZERO",
            "VK_STENCIL_OP_REPLACE",
            "VK_STENCIL_OP_INCREMENT_AND_CLAMP",
            "VK_STENCIL_OP_DECREMENT_AND_CLAMP",
            "VK_STENCIL_OP_INVERT",
            "VK_STENCIL_OP_INCREMENT_AND_WRAP",
            "VK_STENCIL_OP_DECREMENT_AND_WRAP"
          ]
        },
        "compareOp": {
          "type": "string",
          "enum": [
            "VK_COMPARE_OP_NEVER",
            "VK_COMPARE_OP_LESS",
            "VK_COMPARE_OP_EQUAL",
            "VK_COMPARE_OP_LESS_OR_EQUAL",
            "VK_COMPARE_OP_GREATER",
            "VK_COMPARE_OP_NOT_EQUAL",
            "VK_COMPARE_OP_GREATER_OR_EQUAL",
            "VK_COMPARE_OP_ALWAYS"
          ]
        },
        "compareMask": {
          "type": "integer"
        },
        "writeMask": {
          "type": "integer"
        },
        "reference": {
          "type": "integer"
        }
      },
      "required": [
        "failOp",
        "passOp",
        "depthFailOp",
        "compareOp",
        "compareMask",
        "writeMask",
        "reference"
      ],
      "additionalProperties": false
    },
    "PipelineColorBlendStateCreateInfo": {
      "type": "object",
      "properties": {
        "sType": {
          "enum": ["VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO"]
        },
        "pNext": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "logicOpEnable": {
          "type": "boolean"
        },
        "logicOp": {
          "type": "string",
          "enum": [
            "VK_LOGIC_OP_CLEAR",
            "VK_LOGIC_OP_AND",
            "VK_LOGIC_OP_AND_REVERSE",
            "VK_LOGIC_OP_COPY",
            "VK_LOGIC_OP_AND_INVERTED",
            "VK_LOGIC_OP_NO_OP",
            "VK_LOGIC_OP_XOR",
            "VK_LOGIC_OP_OR",
            "VK_LOGIC_OP_NOR",
            "VK_LOGIC_OP_EQUIVALENT",
            "VK_LOGIC_OP_INVERT",
            "VK_LOGIC_OP_OR_REVERSE",
            "VK_LOGIC_OP_COPY_INVERTED",
            "VK_LOGIC_OP_OR_INVERTED",
            "VK_LOGIC_OP_NAND",
            "VK_LOGIC_OP_SET"
          ]
        },
        "attachmentCount": {
          "type": "integer"
        },
        "pAttachments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PipelineColorBlendAttachmentState"
          }
        },
        "blendConstants": {
          "description": "An array of 4 blend constants",
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["sType", "attachmentCount", "pAttachments"],
      "additionalProperties": false
    },
    "PipelineColorBlendAttachmentState": {
      "type": "object",
      "properties": {
        "blendEnable": {
          "type": "boolean"
        },
        "srcColorBlendFactor": {
          "type": "string",
          "enum": [
            "VK_BLEND_FACTOR_ZERO",
            "VK_BLEND_FACTOR_ONE",
            "VK_BLEND_FACTOR_SRC_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR",
            "VK_BLEND_FACTOR_DST_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR",
            "VK_BLEND_FACTOR_SRC_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA",
            "VK_BLEND_FACTOR_DST_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA",
            "VK_BLEND_FACTOR_CONSTANT_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR",
            "VK_BLEND_FACTOR_CONSTANT_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA",
            "VK_BLEND_FACTOR_SRC_ALPHA_SATURATE",
            "VK_BLEND_FACTOR_SRC1_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC1_COLOR",
            "VK_BLEND_FACTOR_SRC1_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA"
          ]
        },
        "dstColorBlendFactor": {
          "type": "string",
          "enum": [
            "VK_BLEND_FACTOR_ZERO",
            "VK_BLEND_FACTOR_ONE",
            "VK_BLEND_FACTOR_SRC_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR",
            "VK_BLEND_FACTOR_DST_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR",
            "VK_BLEND_FACTOR_SRC_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA",
            "VK_BLEND_FACTOR_DST_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA",
            "VK_BLEND_FACTOR_CONSTANT_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR",
            "VK_BLEND_FACTOR_CONSTANT_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA",
            "VK_BLEND_FACTOR_SRC_ALPHA_SATURATE",
            "VK_BLEND_FACTOR_SRC1_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC1_COLOR",
            "VK_BLEND_FACTOR_SRC1_ALPHA",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA"
          ]
        },
        "colorBlendOp": {
          "type": "string",
          "enum": [
            "VK_BLEND_OP_ADD",
            "VK_BLEND_OP_SUBTRACT",
            "VK_BLEND_OP_REVERSE_SUBTRACT",
            "VK_BLEND_OP_MIN",
            "VK_BLEND_OP_MAX"
          ]
        },
        "srcAlphaBlendFactor": {
          "type": "string",
          "enum": [
            "VK_BLEND_FACTOR_ZERO",
            "VK_BLEND_FACTOR_ONE",
            "VK_BLEND_FACTOR_SRC_COLOR",
            "VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR",
